<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference to the RabbitClientEasyNetQ library -->
    <ProjectReference Include="..\src\RabbitClientEasyNetQ\RabbitClientEasyNetQ.csproj" />
    
    <!-- EasyNetQ for DI integration -->
    <PackageReference Include="EasyNetQ" Version="8.*" />
    
    <!-- Microsoft.Extensions.DependencyInjection for DI -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.*" />
    
    <!-- Microsoft.Extensions.Logging for logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.*" />
    
    <!-- Microsoft.Extensions.Hosting for host builder -->
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.*" />
  </ItemGroup>

</Project>
